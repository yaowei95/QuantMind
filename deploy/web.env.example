# Web 前端部署配置模板：复制为 deploy/web.local.env（已 gitignore）后按实际填写
#   cp deploy/web.env.example deploy/web.local.env
# scripts/deploy_frontend.sh 会自动读取；命令行传入的同名变量优先。

# 托管前端的 Nginx 主机（ssh 目标，需免密登录）
SSH_TARGET=root@<nginx 主机 IP>

# Nginx 主机上存放前端文件的目录 = @HTML_ROOT@@WEB_PATH@（只放构建产物）
WEB_DIR=/usr/share/nginx/html/QuantMind

# Nginx 主机本机访问前端的地址（部署后校验用）：http://127.0.0.1:<端口>@WEB_PATH@
WEB_URL=http://127.0.0.1:80/QuantMind/
